{"id":1,"name":"TRAVEL_Heights","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":201,"indent":0,"parameters":[0,33,13,16,2,0]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":1,"walkAnime":true}],"x":0,"y":8},
{"id":2,"name":"SQ_Spiritualist","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"tileId":0,"characterName":"Civilian2","direction":6,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Awfully snoopy to be peaking through other people's "]},{"code":401,"indent":0,"parameters":["windows, isn't it?\""]},{"code":102,"indent":0,"parameters":[["\"Your music drew my attention.\"","\"How'd you know I was there?\""],1,0,2,0]},{"code":402,"indent":0,"parameters":[0,"\"Your music drew my attention.\""]},{"code":101,"indent":1,"parameters":["",0,0,2,"???"]},{"code":401,"indent":1,"parameters":["\"Did it? I hope it wasn't too loud. I hope I'm not being"]},{"code":401,"indent":1,"parameters":["troublesome.\""]},{"code":0,"indent":1,"parameters":[]},{"code":402,"indent":0,"parameters":[1,"\"How'd you know I was there?\""]},{"code":101,"indent":1,"parameters":["",0,0,2,"???"]},{"code":401,"indent":1,"parameters":["\"A true man of the instrument must have ears capable of "]},{"code":401,"indent":1,"parameters":["hearing dust hit the ground if they're to stay sharp!\""]},{"code":101,"indent":1,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":1,"parameters":["\"It's still amazing that you were able to hear me over your"]},{"code":401,"indent":1,"parameters":["piano.\""]},{"code":101,"indent":1,"parameters":["",0,0,2,"???"]},{"code":401,"indent":1,"parameters":["\"Well we all have our talents, don't we?\""]},{"code":0,"indent":1,"parameters":[]},{"code":404,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"You might be wondering why I chose to invite you in.\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Rest assured, I'm not naive. If I sensed you were trouble"]},{"code":401,"indent":0,"parameters":["I would've had my hounds on you before you could gasp!\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"But your soul exudes an alluring radiance...\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Tell me, what do you know of the supernatural?\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\"Supernatural?\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"The supernatural: magical, surreal, strange! The bizarre"]},{"code":401,"indent":0,"parameters":["things most normal people may never see... You've had no"]},{"code":401,"indent":0,"parameters":["such encounters? Well then, I'm afraid you might see them"]},{"code":401,"indent":0,"parameters":["soon...\""]},{"code":213,"indent":0,"parameters":[-1,2,false]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"On that note, you intrigue me! Perhaps I could procure "]},{"code":401,"indent":0,"parameters":["your assistance for a certain *lucractive* endeavor?\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"I have come here to by temporary home for two reasons! One,"]},{"code":401,"indent":0,"parameters":["two observe the start of the race. Two, to investigate a"]},{"code":401,"indent":0,"parameters":["series of preternatural rumors I heard from the grapevine.\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"A haunted hotel, amorphous sewer beasts, and a cursed"]},{"code":401,"indent":0,"parameters":["derelict...\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Let us begin with the first! In Room 3327 of the local,"]},{"code":401,"indent":0,"parameters":["prestigious Hotel Coronado, the ghost of a woman who "]},{"code":401,"indent":0,"parameters":["checked in under a fake name was found dead by gunshot!\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"If the legends are true, her spirit is trapped in that"]},{"code":401,"indent":0,"parameters":["place! Find a way in, and investigate for yourself. Then"]},{"code":401,"indent":0,"parameters":["report back to me.\""]},{"code":122,"indent":0,"parameters":[10,10,0,0,2]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true},{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":10,"variableValid":true,"variableValue":2},"directionFix":false,"image":{"tileId":0,"characterName":"Civilian2","direction":6,"pattern":1,"characterIndex":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"\\N[1]"]},{"code":401,"indent":0,"parameters":["\"So...why not do this yourself?\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Because I am an archivist of supernatural knowledge. One"]},{"code":401,"indent":0,"parameters":["who gathers the tales of many, and gives them to others so"]},{"code":401,"indent":0,"parameters":["that they may know of the hidden truths concealed by the"]},{"code":401,"indent":0,"parameters":["mundanity of society!\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Also because I'm scared of that stuff!\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"???"]},{"code":401,"indent":0,"parameters":["\"Now get to it! You will be rewarded.\""]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":1,"stepAnime":false,"through":false,"trigger":0,"walkAnime":true}],"x":7,"y":6}
