{"id":1,"name":"MAIN_Newspaper1","note":"","pages":[{"conditions":{"actorId":1,"actorValid":false,"itemId":1,"itemValid":false,"selfSwitchCh":"A","selfSwitchValid":false,"switch1Id":1,"switch1Valid":false,"switch2Id":1,"switch2Valid":false,"variableId":1,"variableValid":false,"variableValue":0},"directionFix":false,"image":{"characterIndex":0,"characterName":"","direction":2,"pattern":0,"tileId":0},"list":[{"code":101,"indent":0,"parameters":["",0,0,2,"Johnny"]},{"code":401,"indent":0,"parameters":["\"This may be a little sudden... but I'd like to introduce"]},{"code":401,"indent":0,"parameters":["a story in a newspaper from a certain European country,"]},{"code":401,"indent":0,"parameters":["dated April 23, 1890.\""]},{"code":222,"indent":0,"parameters":[]},{"code":101,"indent":0,"parameters":["",0,0,2,"Johnny"]},{"code":401,"indent":0,"parameters":["\"In that country, there was a boy named 'Marco'. He was"]},{"code":401,"indent":0,"parameters":["9 years old.\""]},{"code":108,"indent":0,"parameters":["(Img of Marco)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Johnny"]},{"code":401,"indent":0,"parameters":["\"The boy's family was from a line of servants to the "]},{"code":401,"indent":0,"parameters":["aristocrats. When he came of age, he was sent to serve "]},{"code":401,"indent":0,"parameters":["under a man named Baron Rippi, and his job would be to "]},{"code":401,"indent":0,"parameters":["clean hats and shoes.\""]},{"code":108,"indent":0,"parameters":["(New img of Marco and father)"]},{"code":101,"indent":0,"parameters":["",0,0,2,"Johnny"]},{"code":401,"indent":0,"parameters":["\"When he was about to leave, his father told him this:\""]},{"code":101,"indent":0,"parameters":["",0,0,2,"Johnny"]},{"code":401,"indent":0,"parameters":["\"'This job will earn you happiness as long as you remain"]},{"code":401,"indent":0,"parameters":["humble and earnest'...\""]},{"code":0,"indent":0,"parameters":[]}],"moveFrequency":3,"moveRoute":{"list":[{"code":0,"parameters":[]}],"repeat":true,"skippable":false,"wait":false},"moveSpeed":3,"moveType":0,"priorityType":0,"stepAnime":false,"through":false,"trigger":3,"walkAnime":true}],"x":0,"y":0}
